{
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.40.0"],
      "env": {"FIRECRAWL_API_KEY": "fc-placeholder-injected-by-proxy"}
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@0.2.22"],
      "env": {"TAVILY_API_KEY": "tvly-placeholder-injected-by-proxy"}
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": {"PERPLEXITY_API_KEY": "pplx-placeholder-injected-by-proxy"}
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": {"Authorization": "Bearer phx-placeholder-injected-by-proxy"}
    }
  }
}
